#!/bin/bash

# Build, check the §12 startup budget, then run the test suite.

set -e

cd "$(dirname "$0")/.."

./bin/build

(
  cd tests
  qmake6 tests.pro
  make -j"$(nproc)"
)

# The QML suite is its own binary: it needs a QGuiApplication and a scene graph, where
# tst_omafile runs headless under QCoreApplication. Built here with the rest so the
# startup measurement below still happens after every compile has finished.
(
  cd tests/qml
  qmake6 qml.pro
  make -j"$(nproc)"
)

# Startup is measured *before* the suite, not after. The search budget test writes and
# then deletes a 100k-file tree, and measuring cold start while the kernel is still
# working through that produced a phantom 60 ms regression and 600 ms outliers.
#
# It is also measured after a settle, and after a discarded warm-up run, because the
# `make -j` above is the same hazard from the other side: sampling straight out of a
# saturating compile reads 175 ms where the same binary reads 100 ms a few seconds later.
measure_startup() {
  local budget_ms=140
  local samples=()
  local reading

  if [[ -z $WAYLAND_DISPLAY && -z $DISPLAY ]]; then
    echo "SKIP  : startup budget (no display)"
    return 0
  fi

  # Long enough to outlast three compiles' worth of writeback and CPU heat. Five seconds
  # was enough when this built one test binary; it is not enough now that it builds two,
  # and the symptom is a startup "regression" that a settled machine cannot reproduce.
  sleep 15
  OMAFILE_TRACE_STARTUP=quit timeout 20 ./build/omafile >/dev/null 2>&1 || true
  OMAFILE_TRACE_STARTUP=quit timeout 20 ./build/omafile >/dev/null 2>&1 || true

  for _ in {1..11}; do
    reading=$(OMAFILE_TRACE_STARTUP=quit timeout 20 ./build/omafile 2>/dev/null | awk '/^startup_ms/ {print $2}')
    [[ -n $reading ]] && samples+=("$reading")
    sleep 0.5
  done

  if (( ${#samples[@]} == 0 )); then
    echo "FAIL  : startup budget (no samples collected)"
    return 1
  fi

  # Compare the median, not the worst case: window creation contends with the
  # compositor, and one stalled frame should not fail the suite.
  local sorted median
  sorted=$(printf '%s\n' "${samples[@]}" | sort -n)
  median=$(printf '%s\n' "$sorted" | awk '{ a[NR] = $1 } END { print a[int((NR + 1) / 2)] }')

  echo "startup: median ${median}ms over ${#samples[@]} runs (budget ${budget_ms}ms) [$(echo $sorted | tr '\n' ' ')]"

  if (( median > budget_ms )); then
    echo "FAIL  : startup budget exceeded"
    return 1
  fi
  echo "PASS  : startup budget"
}

startup_status=0
measure_startup || startup_status=1

suite_status=0
QT_QPA_PLATFORM=offscreen ./build/tests/tst_omafile || suite_status=1

# QT_QUICK_BACKEND=software: no GPU on a CI runner, and none needed to lay out a menu.
QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
  ./build/tests/tst_omafile_qml || suite_status=1

exit $(( startup_status | suite_status ))
